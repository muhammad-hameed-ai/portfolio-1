# Copy this file to .env.local and set a real value before going live.
#
# This secret encrypts and signs the admin login session cookie. It ships
# with a working default (see lib/auth.ts) so the Admin Panel functions
# immediately for testing, but anyone who has this string could forge a
# valid admin session — treat it as seriously as the admin password.
#
# Generate a real one with this command in your terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SESSION_SECRET=paste-a-long-random-string-here-before-going-live
