# Copy this file to .env.local and set a real value before going live.
#
# This secret encrypts and signs the admin login session cookie. It ships
# with a working default (see lib/auth.ts) so the Admin Panel functions
# immediately for testing, but anyone who has this string could forge a
# valid admin session — treat it as seriously as the admin password.
#
# Generate a real one with this command in your terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SESSION_SECRET=paste-a-long-random-string-here-before-going-live

# -----------------------------------------------------------------------
# Git-Sync: Auto-push Admin Panel changes back to GitHub
# -----------------------------------------------------------------------
# On Render's free tier the filesystem resets on every restart. Setting
# these two variables makes the Admin Panel automatically commit and push
# any edits (JSON data + uploaded images) back to the GitHub repo so they
# survive redeploys.
#
# 1. Create a GitHub Personal Access Token (fine-grained) with read/write
#    access to "Contents" for this repository:
#    https://github.com/settings/tokens?type=beta
#
# 2. Set both variables in Render's Environment tab (Dashboard → your
#    Web Service → Environment).
#
# Leave these unset during local development — the sync will be skipped
# automatically and saves still work as normal (they just stay local).

GITHUB_TOKEN=ghp_your-personal-access-token-here
GITHUB_REPO_URL=https://github.com/muhammad-hameed-ai/portfolio-1.git
